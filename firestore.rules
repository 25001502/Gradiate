rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAppAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isCommunityAdmin() {
      return signedIn()
        && (
          exists(/databases/$(database)/documents/communityAdmins/$(request.auth.uid))
          || isAppAdmin()
        );
    }

    function hasField(data, field) {
      return data.keys().hasAny([field]);
    }

    function optionalString(data, field, maxLength) {
      return !hasField(data, field)
        || (data[field] is string && data[field].size() <= maxLength);
    }

    function optionalBool(data, field) {
      return !hasField(data, field) || data[field] is bool;
    }

    function optionalTimestampOrNull(data, field) {
      return !hasField(data, field) || data[field] == null || data[field] is timestamp;
    }

    function optionalCount(data, field) {
      return !hasField(data, field) || (data[field] is number && data[field] >= 0);
    }

    function isValidCommunityCategory(category) {
      return category in ['general', 'questions', 'bursaries', 'applications', 'study', 'wins'];
    }

    function isCommunityPostAuthor(postId) {
      return signedIn()
        && get(/databases/$(database)/documents/communityPosts/$(postId)).data.authorId == request.auth.uid;
    }

    function validCommunityAuthorFields(data) {
      return data.authorId == request.auth.uid
        && data.authorName is string
        && data.authorName.size() > 0
        && data.authorName.size() <= 80
        && optionalString(data, 'authorPhotoURL', 500)
        && optionalString(data, 'authorAvatarSeed', 120)
        && optionalString(data, 'authorAvatarStyle', 40)
        && optionalString(data, 'authorUniversity', 120)
        && optionalString(data, 'authorProgram', 140)
        && optionalString(data, 'authorYearOfStudy', 60);
    }

    function validCommunityPostBase(data) {
      return data.content is string
        && data.content.size() > 0
        && data.content.size() <= 800
        && isValidCommunityCategory(data.category)
        && optionalString(data, 'moduleCode', 40)
        && (!hasField(data, 'tags') || (data.tags is list && data.tags.size() <= 10));
    }

    function validCommunityPostCreate(data) {
      return data.keys().hasOnly([
          'authorId',
          'authorName',
          'authorPhotoURL',
          'authorAvatarSeed',
          'authorAvatarStyle',
          'authorUniversity',
          'authorProgram',
          'authorYearOfStudy',
          'category',
          'content',
          'moduleCode',
          'tags',
          'likeCount',
          'commentCount',
          'saveCount',
          'lastActivityAt',
          'createdAt',
          'updatedAt'
        ])
        && validCommunityAuthorFields(data)
        && validCommunityPostBase(data)
        && data.likeCount == 0
        && data.commentCount == 0
        && data.saveCount == 0
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && data.lastActivityAt == request.time;
    }

    function validAnswerFields(data) {
      return data.category == 'questions'
        && data.isAnswered is bool
        && optionalString(data, 'acceptedCommentId', 120)
        && optionalString(data, 'acceptedAnswerPreview', 180)
        && optionalString(data, 'acceptedAnswerAuthorId', 120)
        && optionalString(data, 'acceptedAnswerAuthorName', 80)
        && optionalTimestampOrNull(data, 'answeredAt');
    }

    function validOwnerCommunityPostUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.authorId == request.auth.uid
        && changed.hasOnly([
          'category',
          'content',
          'moduleCode',
          'tags',
          'updatedAt',
          'isAnswered',
          'acceptedCommentId',
          'acceptedAnswerPreview',
          'acceptedAnswerAuthorId',
          'acceptedAnswerAuthorName',
          'answeredAt',
          'lastActivityAt'
        ])
        && validCommunityPostBase(request.resource.data)
        && (!changed.hasAny(['category', 'content', 'moduleCode', 'tags', 'updatedAt'])
          || request.resource.data.updatedAt == request.time)
        && (!changed.hasAny([
          'isAnswered',
          'acceptedCommentId',
          'acceptedAnswerPreview',
          'acceptedAnswerAuthorId',
          'acceptedAnswerAuthorName',
          'answeredAt'
        ]) || (validAnswerFields(request.resource.data)
          && request.resource.data.lastActivityAt == request.time));
    }

    function countBefore(field) {
      return hasField(resource.data, field) && resource.data[field] is number
        ? resource.data[field]
        : 0;
    }

    function validCounterStep(field) {
      return hasField(request.resource.data, field)
        && request.resource.data[field] is number
        && request.resource.data[field] >= 0
        && (
          request.resource.data[field] == countBefore(field) + 1
          || (countBefore(field) > 0 && request.resource.data[field] == countBefore(field) - 1)
        );
    }

    function validCommunityCounterUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return signedIn()
        && changed.hasOnly(['likeCount', 'commentCount', 'saveCount', 'lastActivityAt'])
        && request.resource.data.lastActivityAt == request.time
        && (
          (changed.hasOnly(['likeCount', 'lastActivityAt'])
            && changed.hasAny(['likeCount'])
            && validCounterStep('likeCount'))
          || (changed.hasOnly(['commentCount', 'lastActivityAt'])
            && changed.hasAny(['commentCount'])
            && validCounterStep('commentCount'))
          || (changed.hasOnly(['saveCount', 'lastActivityAt'])
            && changed.hasAny(['saveCount'])
            && validCounterStep('saveCount'))
        );
    }

    function validAdminCommunityPostUpdate() {
      return isCommunityAdmin()
        && request.resource.data.keys().hasOnly([
          'authorId',
          'authorName',
          'authorPhotoURL',
          'authorAvatarSeed',
          'authorAvatarStyle',
          'authorUniversity',
          'authorProgram',
          'authorYearOfStudy',
          'category',
          'content',
          'moduleCode',
          'tags',
          'likeCount',
          'commentCount',
          'saveCount',
          'lastActivityAt',
          'createdAt',
          'updatedAt',
          'isAnswered',
          'acceptedCommentId',
          'acceptedAnswerPreview',
          'acceptedAnswerAuthorId',
          'acceptedAnswerAuthorName',
          'answeredAt',
          'isOfficial',
          'pinned',
          'pinnedAt'
        ])
        && validCommunityPostBase(request.resource.data)
        && optionalCount(request.resource.data, 'likeCount')
        && optionalCount(request.resource.data, 'commentCount')
        && optionalCount(request.resource.data, 'saveCount')
        && optionalBool(request.resource.data, 'isAnswered')
        && optionalBool(request.resource.data, 'isOfficial')
        && optionalBool(request.resource.data, 'pinned')
        && optionalString(request.resource.data, 'acceptedCommentId', 120)
        && optionalString(request.resource.data, 'acceptedAnswerPreview', 180)
        && optionalString(request.resource.data, 'acceptedAnswerAuthorId', 120)
        && optionalString(request.resource.data, 'acceptedAnswerAuthorName', 80)
        && optionalTimestampOrNull(request.resource.data, 'answeredAt')
        && optionalTimestampOrNull(request.resource.data, 'pinnedAt');
    }

    function validCommunityComment(data) {
      return data.keys().hasOnly([
          'authorId',
          'authorName',
          'authorPhotoURL',
          'authorAvatarSeed',
          'authorAvatarStyle',
          'authorUniversity',
          'authorProgram',
          'authorYearOfStudy',
          'content',
          'createdAt'
        ])
        && validCommunityAuthorFields(data)
        && data.content is string
        && data.content.size() > 0
        && data.content.size() <= 420
        && data.createdAt == request.time;
    }

    function validCommunityNotification(userId, data) {
      return data.recipientId == userId
        && data.actorId == request.auth.uid
        && data.actorId != userId
        && data.actorName is string
        && data.actorName.size() > 0
        && data.actorName.size() <= 80
        && data.actorPhotoURL is string
        && data.actorPhotoURL.size() <= 500
        && data.type in ['like', 'comment']
        && data.postId is string
        && data.postId.size() > 0
        && data.postPreview is string
        && data.postPreview.size() <= 180
        && data.read == false
        && data.createdAt == request.time
        && get(/databases/$(database)/documents/communityPosts/$(data.postId)).data.authorId == userId;
    }

    function validSavedCommunityPost(data) {
      return data.postId is string
        && data.postId.size() > 0
        && data.authorId is string
        && data.authorName is string
        && data.authorName.size() <= 80
        && isValidCommunityCategory(data.category)
        && data.contentPreview is string
        && data.contentPreview.size() <= 200
        && optionalTimestampOrNull(data, 'createdAt')
        && optionalString(data, 'moduleCode', 40)
        && optionalBool(data, 'isAnswered')
        && data.savedAt == request.time;
    }

    function validCommunityReport(data) {
      return data.reporterId == request.auth.uid
        && data.reporterName is string
        && data.reporterName.size() > 0
        && data.reporterName.size() <= 80
        && data.targetType in ['post', 'comment']
        && data.targetId is string
        && data.targetId.size() > 0
        && data.postId is string
        && data.postId.size() > 0
        && data.commentId is string
        && data.targetAuthorId is string
        && data.reason is string
        && data.reason.size() > 0
        && data.reason.size() <= 280
        && data.contentPreview is string
        && data.contentPreview.size() <= 240
        && data.status == 'open'
        && data.createdAt == request.time;
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/bookmarks/{bookmarkId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/practiceSavedSubjects/{subjectId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/bursaryBookmarks/{bursaryId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/savedCommunityPosts/{postId} {
      allow read, delete: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && postId == request.resource.data.postId
        && request.resource.data.keys().hasOnly([
          'postId',
          'authorId',
          'authorName',
          'category',
          'contentPreview',
          'savedAt',
          'createdAt',
          'moduleCode',
          'isAnswered'
        ])
        && validSavedCommunityPost(request.resource.data);
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read, delete: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && (
          // Standard community notifications (like, comment)
          (
            request.resource.data.keys().hasOnly([
              'recipientId',
              'actorId',
              'actorName',
              'actorPhotoURL',
              'type',
              'postId',
              'postPreview',
              'commentId',
              'commentPreview',
              'read',
              'createdAt'
            ])
            && validCommunityNotification(userId, request.resource.data)
            && request.resource.data.commentId is string
            && request.resource.data.commentPreview is string
            && request.resource.data.commentPreview.size() <= 180
          )
          // Admin broadcast notifications — written by Cloud Functions (Admin SDK bypasses rules)
          // This branch covers client-side admin writes as a fallback
          || (
            isAppAdmin()
            && request.resource.data.type == 'adminAnnouncement'
            && request.resource.data.recipientId == userId
            && request.resource.data.read == false
            && request.resource.data.createdAt == request.time
          )
        );
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
        && request.resource.data.read == true
        && request.resource.data.readAt == request.time;
    }

    match /admins/{adminId} {
      allow read: if signedIn() && (request.auth.uid == adminId || isAppAdmin());
      allow create, update, delete: if isAppAdmin();
    }

    match /adminAnnouncements/{announcementId} {
      allow read: if isAppAdmin();
      allow create: if isAppAdmin();
      allow update, delete: if isAppAdmin();
    }

    match /adminAuditLog/{logId} {
      allow read: if isAppAdmin();
      allow create: if isAppAdmin();
      allow update, delete: if false;
    }

    match /communityAdmins/{adminId} {
      allow read: if signedIn() && (request.auth.uid == adminId || isCommunityAdmin());
      allow create, update, delete: if isCommunityAdmin();
    }

    match /communityReports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'reporterId',
          'reporterName',
          'targetType',
          'targetId',
          'postId',
          'commentId',
          'targetAuthorId',
          'reason',
          'contentPreview',
          'status',
          'createdAt'
        ])
        && validCommunityReport(request.resource.data);
      allow read, delete: if isCommunityAdmin();
      allow update: if isCommunityAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'reviewedAt',
          'reviewedBy'
        ])
        && request.resource.data.status in ['reviewed', 'removed']
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewedBy == request.auth.uid;
    }

    match /communityPosts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && validCommunityPostCreate(request.resource.data);
      allow update: if signedIn()
        && (
          validOwnerCommunityPostUpdate()
          || validCommunityCounterUpdate()
          || validAdminCommunityPostUpdate()
        );
      allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || isCommunityAdmin());

      match /likes/{likeUserId} {
        allow read: if true;
        allow create: if signedIn()
          && likeUserId == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow delete: if signedIn()
          && (likeUserId == request.auth.uid || isCommunityPostAuthor(postId) || isCommunityAdmin());
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && validCommunityComment(request.resource.data);
        allow delete: if signedIn()
          && (resource.data.authorId == request.auth.uid || isCommunityPostAuthor(postId) || isCommunityAdmin());
      }
    }
  }
}
